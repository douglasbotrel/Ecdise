# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/ecdise?schema=public"

# Para desenvolvimento com SQLite (mais fácil para começar)
# DATABASE_URL="file:./dev.db"

# JWT Secret (gere uma string aleatória forte)
JWT_SECRET="sua-chave-secreta-muito-forte-aqui-minimo-32-caracteres"
JWT_EXPIRES_IN="7d"

# Next.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="outro-secret-para-nextauth"

# Upload de arquivos
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE=10485760

# App
APP_NAME="Ecdise"
APP_URL="http://localhost:3000"
